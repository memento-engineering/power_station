# Dart / Flutter
.dart_tool/
build/
*.g.dart.bak
.flutter-plugins-dependencies
.packages

# Machine-local dev linkage (generated by the dart domain's `grid dart link`;
# see the_grid docs/SCRATCH-pub-capability-and-repo-split.md). Never tracked —
# path overrides are per-machine context.
pubspec_overrides.yaml

# The lockfile bakes in the (gitignored) path overrides — dev linkage is
# machine-local, so the lock is too.
pubspec.lock

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# .beads/ exclusions are owned by bd's own .beads/.gitignore (kept current with
# `bd doctor`). Do NOT blanket-ignore `.beads/*` with negations here: bd warns
# that negation patterns override the fork protection in .git/info/exclude, and
# the blanket hides files bd expects tracked (config.yaml carries sync.remote,
# so a fresh clone can't bootstrap without it).
#
# Per-machine files bd's template doesn't cover yet:
.beads/hooks.log
.beads/routes.jsonl
.beads/formulas/

# Per-bead worktrees (never tracked — throwaway working copies).
.grid/

# IDE noise
*.iml
.idea/
